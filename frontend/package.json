{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.ssr.json && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/generate-seo-pages.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:ssr": "node server/ssr-server.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "test:e2e": "playwright test --grep-invert \"@production|@motion|@visual|@authenticated\"",
    "test:e2e:smoke": "playwright test --grep @smoke --project=chromium-desktop",
    "test:e2e:authenticated": "playwright test e2e/authenticated.spec.ts --project=chromium-desktop --workers=1",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:motion": "playwright test --grep @motion --project=chromium-motion --workers=1",
    "test:e2e:report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@photo-sphere-viewer/core": "^5.14.1",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.33.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.563.0",
    "maplibre-gl": "6.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "three": "0.186.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.96.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.7"
  }
}
