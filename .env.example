# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clueterra
DB_USER=clueterra
DB_PASSWORD=clueterra_secret
BUDGET_DB_USER=clueterra_budget
BUDGET_DB_PASSWORD=clueterra_budget_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=http://localhost:9000
# Local-development MinIO root credentials.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Each application gets a fixed least-privilege identity and a separate secret.
MINIO_API_SECRET_KEY=replace-with-a-long-random-api-secret
MINIO_QUESTIONS_SECRET_KEY=replace-with-a-long-random-questions-secret
MINIO_BUDGET_SECRET_KEY=replace-with-a-long-random-budget-secret

# Auth
JWT_SECRET=your-256-bit-secret-change-in-production
RATE_LIMIT_KEY_SALT=use-a-long-random-value
# Keep disabled except during an explicitly scheduled production capacity test.
TOTP_ENABLED=true
TOTP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
QUESTIONS_SERVICE_SECRET=123
BUDGET_SERVICE_SECRET=123

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain
DOMAIN=clueterra.com
CLOUDFLARE_TUNNEL_TOKEN=
FRONTEND_URL=http://localhost:3001
BACKEND_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# External API Keys
GITHUB_TOKEN=
GEONAMES_USERNAME=
MAPILLARY_CLIENT_TOKEN=

# Ai API Key
CLUETERRA_AI_API_KEY=
